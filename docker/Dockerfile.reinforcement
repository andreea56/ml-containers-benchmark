FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

COPY src/common ./common
COPY src/reinforcement ./reinforcement

RUN groupadd -r mluser && useradd -r -g mluser -d /app -s /usr/sbin/nologin mluser \
    && mkdir -p /data /output \
    && chown -R mluser:mluser /app /data /output

USER mluser

ENV DATA_DIR=/data \
    OUTPUT_DIR=/output \
    PYTHONUNBUFFERED=1

ARG ALGO=sarsa_agent.py
ENV ALGO=${ALGO}

ENTRYPOINT ["sh", "-c", "python reinforcement/${ALGO}"]